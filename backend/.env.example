# Gemini API Configuration (required -- app exits at startup if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Configuration (required -- app exits at startup if unset)
# For local dev via `docker compose up`, this points at the bundled
# mongo:7.0 service by its compose service name. For production, replace
# with your MongoDB Atlas (or other) connection string.
MONGODB_URI=mongodb://mongo:27017/devpost_data
DATABASE_NAME=devpost_data
COLLECTION_NAME=participants

# CORS: browser origin allowed to call this API (the frontend dev server
# or its production URL). Only one origin is allowed at a time.
ALLOWED_ORIGIN=http://localhost:5173

# Flask debug mode (Werkzeug interactive debugger). Leave unset/false
# except for local troubleshooting -- it allows remote code execution
# if the port is ever reachable from outside localhost.
FLASK_DEBUG=false

# Devpost Authentication Cookies
# To get these values:
# 1. Log in to Devpost in your browser
# 2. Open Developer Tools (F12) > Application > Cookies > devpost.com
# 3. Copy the values for each cookie below
DEVPOST_JWT=your_jwt_token_here
DEVPOST_REMEMBER_USER_TOKEN=your_remember_user_token_here
DEVPOST_SESSION=your_devpost_session_cookie_here
DEVPOST_AWS_WAF_TOKEN=your_aws_waf_token_here
DEVPOST_GA=your_google_analytics_cookie_here
