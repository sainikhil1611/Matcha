# Base URL for the Flask backend API (backend/app.py). Used by both
# src/services/api.js and src/pages/Ideas.jsx -- there is only one
# backend in this repo, so only one var is needed.
# This is a Vite build-time variable: it must be set before `npm run
# build` / `npm run dev`, changing it requires a rebuild/restart.
VITE_API_URL=http://127.0.0.1:5000/api

# Auth0 (optional). Referenced by src/auth/auth0-config.js and used by
# the Auth0 login button in Sidebar.jsx/Landing.jsx, but the primary
# sign-in flow in src/context/AuthContext.jsx is a localStorage mock
# login that does not require Auth0. Leave unset unless you are testing
# the Auth0 login path specifically.
VITE_AUTH0_DOMAIN=your_auth0_domain.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id_here
VITE_AUTH0_AUDIENCE=
